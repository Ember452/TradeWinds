# TradeWinds 环境变量样例 —— 复制为 .env 后按需修改
# 全部变量使用 TRADEWINDS_ 前缀,由 pydantic-settings 读取(Task 1.2 落地校验)

# --- 数据库 / Redis ---
TRADEWINDS_DATABASE_URL=postgresql+asyncpg://tradewinds:tradewinds@localhost:5432/tradewinds
TRADEWINDS_REDIS_URL=redis://localhost:6379/0

# --- 认证 ---
TRADEWINDS_JWT_SECRET=change-me-to-a-long-random-string
TRADEWINDS_JWT_EXPIRE_MINUTES=1440

# --- LLM(OpenAI-compatible,代码不出现型号字符串,型号全部走这里) ---
TRADEWINDS_LLM_API_BASE=https://api.deepseek.com/v1
TRADEWINDS_LLM_API_KEY=change-me
TRADEWINDS_MODEL_LOW=deepseek-chat
TRADEWINDS_MODEL_MID=deepseek-chat
TRADEWINDS_GITHUB_TOKEN=

# --- 可观测 ---
TRADEWINDS_LOG_LEVEL=INFO
TRADEWINDS_SENTRY_DSN=
TRADEWINDS_SENTRY_ENVIRONMENT=production
TRADEWINDS_OPS_TOKEN=

# --- 限流 ---
TRADEWINDS_AUTH_RATE_LIMIT_MAX=10
TRADEWINDS_AUTH_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Agent 工具循环 ---
TRADEWINDS_LOOP_MAX_ITERATIONS=10
TRADEWINDS_LOOP_TOTAL_TIMEOUT_SECONDS=120
TRADEWINDS_LOOP_MAX_CONTEXT_CHARS=24000

# --- 管道 ---
TRADEWINDS_PIPELINE_SCORE_THRESHOLD=6

# --- 对话 Agent ---
TRADEWINDS_CHAT_CONCURRENCY_LIMIT=3

# --- 邮件推送 ---
TRADEWINDS_APP_BASE_URL=https://your-domain.com
TRADEWINDS_EMAIL_ENABLED=false
TRADEWINDS_SMTP_HOST=
TRADEWINDS_SMTP_PORT=587
TRADEWINDS_SMTP_USER=
TRADEWINDS_SMTP_PASSWORD=
TRADEWINDS_SMTP_FROM=noreply@your-domain.com
TRADEWINDS_SMTP_START_TLS=true
